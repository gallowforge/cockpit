# The dashboard listens on a unix socket that the reverse proxy reaches; no
# TCP port is opened. The socket lives in /run/vesper, which tmpfiles keeps,
# so a proxy container that mounts the directory never holds a stale socket.
[Unit]
Description=Vesper dashboard socket
Documentation=https://github.com/gallowforge/vesper

[Socket]
ListenStream=/run/vesper/web.sock
SocketMode=0660
SocketUser=root
SocketGroup=root

[Install]
WantedBy=sockets.target
